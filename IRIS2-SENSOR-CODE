    // Serial.println(strlen(sendData));   // CRC datu paketei ar pašu CRC
    strcat(sendData, ";");
    dataReady = true;
  }
#endif

  // ************************************************* EC(......)
#ifdef SENSOR_EC
  if (strcmp(groupID, "$EC") == 0) {
    wdt_enable(WDTO_8S);
    digitalWrite(sensorPowerPin, HIGH);
    delay(2500);
    myserial.listen();
    delay(10);
    sensorstring = "";               // sākam ar tukšu virkni (citādi nepabeigta atbilde krājas starp cikliem)
    sensor_string_complete = false;
    //  Serial.println(F("EC start"));
    myserial.print(F("R"));   //manuali definets, lai sataisa
    myserial.print('\r');  //single reading
    Serial.println(F("Call sensor"));

    // EZO EC mērījums aizņem ~600 ms, tāpēc gaidām līdz <CR>, bet ne ilgāk par 1500 ms
    // (bija fiksēts delay(500) — atbilde bieži vēl nebija pienākusi)
    unsigned long ecStart = millis();
    while (!sensor_string_complete && millis() - ecStart < 1500) {
      while (myserial.available() > 0) {      //if we see that the Atlas Scientific product has sent a character
        char inchar = (char)myserial.read();  //get the char we just received
        if (sensorstring.length() < 30) sensorstring += inchar;  //add the char to the var called sensorstring
        Serial.print(inchar);
        if (inchar == '\r') {             //if the incoming character is a <CR>
          sensor_string_complete = true;  //set the flag
          Serial.println(F("Receive Data"));
          break;
        }
      }
    }
    digitalWrite(sensorPowerPin, LOW);
    wdt_disable();
    radio.listen();

    if (sensor_string_complete == true) {       //if a string from the Atlas Scientific product has been received in its entirety
      if (isdigit(sensorstring[0]) == false) {  //if the first character in the string is a digit
        Serial.println(sensorstring);           //send that string to the PC's serial monitor
      } else                                    //if the first character in the string is NOT a digit
      {
        print_EC_data();  //then call this function
      }
      sensorstring = "";               //clear the string
      sensor_string_complete = false;  //reset the flag used to tell if we have received a completed string from the Atlas Scientific product
    }

    strcat(sendData, groupID);
    strcat(sendData, "/");
    strcat(sendData, sensID);

    strcat(sendData, "/");
    ltoa(long(f_ec * 10), pData, DEC);  // bija itoa(int(...)): int pārpildās, ja EC > 3276.7 µS/cm
    strcat(sendData, pData);

    strcat(sendData, "/");
    itoa(int(voltage * 100), pData, DEC);
    strcat(sendData, pData);

    strcat(sendData, "/");
    itoa(strlen(sendData) + 2, pData, DEC);  // CRC datu paketei
    strcat(sendData, pData);
    // Serial.println(strlen(sendData));   // CRC datu paketei ar pašu CRC
