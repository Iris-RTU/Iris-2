    Wire.begin();          // Sāk I2C komunikāciju no jauna
    Wire.setClock(50000);  //pazemināts i2c atrums
    delay(10);
    // Serial.println ("Sensor starting");
    while (airSensor.begin() != true) {
      // Serial.print(F("."));
      delay(1);
